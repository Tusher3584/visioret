# Production settings for docker-compose.prod.yml. See DEPLOYMENT.md.
#
# On the server:
#   cp .env.production.example .env
#   nano .env
#
# `.env` is gitignored. These values must never be committed or pasted
# anywhere public.

# Where the site is served from.
#   Azure VM:          the VM's DNS name, WITHOUT https:// -- Caddy then gets
#                      a free HTTPS certificate automatically, e.g.
#                      visioret.eastasia.cloudapp.azure.com
#   GitHub Codespaces: :80          (Codespaces provides HTTPS itself)
#   Local test:        http://localhost
SITE_ADDRESS=replace-me

# Signing key for login tokens. REQUIRED, no default. Generate with:
#   openssl rand -hex 32
JWT_SECRET_KEY=replace-me

# Database password. Generate a DIFFERENT value with:
#   openssl rand -hex 24
# Only takes effect the first time the database volume is created; changing
# it later requires changing it inside Postgres too.
POSTGRES_PASSWORD=replace-me
