# Copy this file to `.env` in the project root and fill in the values.
# `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Docker Compose reads this file automatically for variable substitution, so
# `docker compose up` picks these up with no extra flags.

# Signing key for authentication tokens. REQUIRED -- there is no default.
# backend/auth.py raises RuntimeError at import if this is missing, and
# docker-compose.yml refuses to start without it. That is deliberate: a
# fallback signing key is a fallback that ends up in production, and anyone
# who knows it can forge a token for any account, including an admin.
#
# Generate a fresh one (do not reuse this placeholder):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-me-with-a-generated-64-character-hex-string

# SQLAlchemy connection string. Only needed when running the backend OUTSIDE
# Docker -- docker-compose.yml sets its own value pointing at the `db`
# service, which overrides this one. Port 5433 is the host mapping for the
# compose Postgres container (5432 was already taken on the dev machine).
DATABASE_URL=postgresql+psycopg2://visioret:visioret@localhost:5433/visioret
